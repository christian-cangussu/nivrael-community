# ═══════════════════════════════════════════════════════════════════════════
#  Nivrael — community edition · environment variables
#
#  Copy to `.env` and edit. Everything has a working default for local play:
#  with Docker, `docker compose up` needs NOTHING from this file.
#  (PT) Copie para `.env`. Tudo tem um valor que funciona para jogar em casa.
#  (ES) Copia a `.env`. Todo tiene un valor que funciona para jugar en casa.
#
#  The second half lists every balance knob the game reads, with its default,
#  grouped by the system that reads it. Leave them commented unless you are
#  tuning a world. `scripts/_test_edicao_comunitaria.py` fails if the code ever
#  reads a variable that is not documented here.
# ═══════════════════════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────────────────────
# One PostgreSQL (17 recommended; 16 works). Each game world is its own
# database on the same server; the local world is created on first boot as
# <database>_local, so the role needs CREATEDB (the docker image has it).
DATABASE_URL=postgresql+asyncpg://nivrael:nivrael@localhost:5432/nivrael
# Control plane (accounts, sessions, world registry). Empty = same as DATABASE_URL.
# CONTROL_DATABASE_URL=
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=20
# WORLD_DEFAULT_POOL_SIZE=5
# WORLD_DEFAULT_MAX_OVERFLOW=5

# ── Community edition ───────────────────────────────────────────────────────
# Real-money flows (Telegram Stars) and the gacha exist only in the official
# game. 0 = off (default). 1 = behave like the official game.
NIVRAEL_MONETIZATION=0
# Local development login: sign in with just a NAME, no password.
# 1 = on. Refuses to open when WEBHOOK_URL is set, and only accepts requests
# from this machine or the local network. NEVER enable it on a public server.
# NIVRAEL_DEV_LOGIN=1
# Where `python -m community.local` listens. Docker sets 0.0.0.0.
# NIVRAEL_HTTP_HOST=127.0.0.1
# NIVRAEL_HTTP_PORT=8080
# The local world (all 40 feature flags on), created on first boot.
# NIVRAEL_LOCAL_WORLD=local
# NIVRAEL_LOCAL_WORLD_NAME=Mundo Local
# Where new players are born. community.local defaults it to the local world.
# SIGNUP_WORLD=local
# Local state (the generated session secret lives here).
# NIVRAEL_STATE_DIR=.nivrael
# NIVRAEL_LOG_LEVEL=INFO

# ── Web sessions and sign-in ────────────────────────────────────────────────
# Signs the session cookie. Empty + no BOT_TOKEN = community.local generates one
# in NIVRAEL_STATE_DIR. Set a long random value on any server you expose.
# SESSION_SECRET=
# Plain http (local only). community.local sets it when NIVRAEL_DEV_LOGIN=1.
# NIVRAEL_COOKIE_INSECURE=1
# Google / Apple / e-mail sign-in: YOUR Firebase project (web config). Empty =
# those buttons stay off. The official game's project is NOT a default here.
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_APP_ID=

# ── Telegram (optional — the browser game runs without it) ──────────────────
# With a token, `python main.py` runs the chat bot + Mini App (your own bot).
# BOT_TOKEN=
# WEBHOOK_URL=
# WEBHOOK_PATH=/webhook
# WEBHOOK_SECRET=
# PORT=8443
# MINIAPP_URL=
# LOGIN_BOT_USERNAME=
# Telegram ids allowed into the admin panel (comma separated). A browser
# account has a negative id — it is shown in the server log at sign-in.
# ADMIN_USERS=
# FEEDBACK_GROUP_URL=https://t.me/Nivrael_RPG
# MOD_WHITELIST_DOMAINS=
# MOD_WHITELIST_TME=Nivrael_RPG
# MOD_STRIKE_LIMIT=3

# ── Public pages ────────────────────────────────────────────────────────────
# Data requests on /privacy and /terms go here. Required on any public instance
# (the default is a placeholder that receives no mail). Those pages describe the
# official game: rewrite them for yours before going public.
# LEGAL_CONTACT_EMAIL=
# The world shown on /play (default: the signup world).
# VITRINE_WORLD=
# "Open in Telegram" / "Play in your browser" on /play.
# VITRINE_BOT_URL=https://t.me/Nivrael_bot
# VITRINE_WEB_URL=

# ── Game loop ───────────────────────────────────────────────────────────────
# TICK_INTERVAL_SECONDS=30
# OFFLINE_CAP_SECONDS=14400
# CULTIVATION_BATCH_SIZE=100
# ONLINE_THRESHOLD_SECONDS=300
# ADMIN_ALERT_THRESHOLD=1000000
# NPC_LEADERBOARD_ENABLED=

# ── Fate seeds ──────────────────────────────────────────────────────────────
# Race, spirit-root element and NPC fates are derived from these. Change them
# BEFORE anyone is born in a world; changing them later rewrites destinies.
# RACE_HASH_SALT=nivrael_trackA_races
# ROOT_ELEMENT_HASH_SALT=nivrael_trackA_roots
# NPC_CULTIVATOR_HASH_SALT=nivrael_onda3_echo
# LIFESPAN_NPC_AGE_SALT=nivrael_trackA_lifespan

# ── Tools (not read by the server) ──────────────────────────────────────────
# scripts/gen_art.py — image generation (your own key; commercial-use tier).
# NV_IMAGE_API_KEY=
# scripts/_olhar_cdp.mjs — the browser the test suites drive headless (a Chrome
# or Chromium executable). Empty = the newest one agent-browser installed.
# NV_CHROME=

